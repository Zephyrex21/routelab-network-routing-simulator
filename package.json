{
  "name": "routelab",
  "private": true,
  "version": "0.9.6",
  "type": "module",
  "description": "An educational web-based simulator for Distance Vector and Link State routing algorithms.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e",
    "test": "node --test",
    "test:engine": "node --test tests/routing-engine.test.js",
    "test:simulation": "node --test tests/simulation-view-model.test.js",
    "test:packet": "node --test tests/packet-routing.test.js",
    "test:failure": "node --test tests/failure-experiment.test.js",
    "test:comparison": "node --test tests/algorithm-comparison.test.js",
    "audit": "npm audit --audit-level=high",
    "check:release": "npm run check && npm run audit",
    "lint": "npm exec --yes --package=eslint@10.15.0 -- eslint \"src/**/*.{js,jsx}\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"vite.config.js\"",
    "test:e2e": "npm exec --yes --package=playwright@1.65.1 -- node scripts/browser-smoke.mjs",
    "test:e2e:install": "npm exec --yes --package=playwright@1.65.1 -- playwright install chromium"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
