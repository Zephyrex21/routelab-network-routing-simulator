{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routelab.local/schemas/network-project.schema.json",
  "title": "RouteLab Network Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "createdAt", "updatedAt", "topologyRevision", "routers", "links"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "topologyRevision": { "type": "integer", "minimum": 1 },
    "routers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "position"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,15}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 40 },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceRouterId", "targetRouterId", "cost", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceRouterId": { "type": "string", "minLength": 1 },
          "targetRouterId": { "type": "string", "minLength": 1 },
          "cost": { "type": "integer", "minimum": 1, "maximum": 999 },
          "status": { "enum": ["up", "down"] }
        }
      }
    }
  }
}
